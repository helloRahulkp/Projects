# =============================================================================
# Frontend Dockerfile — AI Currency Detection System v2.0
# Streamlit UI | Cross-platform: linux/amd64 + linux/arm64
# =============================================================================

FROM python:3.11-slim

LABEL description="Streamlit frontend for AI Currency Detection System"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/frontend.txt .
RUN pip install --no-cache-dir -r frontend.txt

COPY frontend/ ./frontend/

# Streamlit config to disable telemetry and set theme
RUN mkdir -p /root/.streamlit
COPY configs/streamlit_config.toml /root/.streamlit/config.toml

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
