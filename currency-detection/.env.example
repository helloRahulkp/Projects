# =============================================================================
# .env — AI Currency Detection System v2.0
# Copy this to .env and customize as needed.
# =============================================================================

# Hardware device: cpu | cuda | mps
DEVICE=cpu

# Logging
LOG_LEVEL=INFO

# Model
MODEL_PATH=models/checkpoints/best.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend → Backend URL (used inside Docker)
API_URL=http://backend:8000

# Currency API (optional — open.er-api.com works without a key)
CURRENCY_API_KEY=

# Debug mode (set to True for development)
DEBUG=False
